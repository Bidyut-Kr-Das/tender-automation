# Copy to .env (local) or .env.production (docker-compose) and fill in.
# [REQUIRED]  app fails to start / connect without it
# [OPTIONAL]  feature-specific; default shown, empty = feature disabled

# --- Django ---
# config.settings (legacy tender_search) or config.settings_v2 (automation_v2)
DJANGO_SETTINGS_MODULE=config.settings

# --- Databases ---
# [REQUIRED for legacy] tender_search DB. Unset = no DB configured.
DATABASE_URL=postgres://user:password@localhost:5432/tenders
# [REQUIRED for v2] settings_v2 raises KeyError if missing
AUTOMATION_V2_DATABASE_URL=postgres://user:password@localhost:5432/automation_v2

# --- RabbitMQ ---
# [REQUIRED] all consumers/dispatchers raise if empty
MQ_URL=amqp://guest:guest@localhost:5672/%2F
# [OPTIONAL] queue names
TENDER_TASKS_QUEUE=tender:tasks 
TENDER_PARSING_QUEUE=tender:parsing
AGENT_INGESTION_QUEUE=agent:ingestion
V2_TASKS_QUEUE=automation-v2:tasks
V2_PARSING_QUEUE=automation-v2:parsing

# --- Costing API (costing_excel_parse) ---
# [OPTIONAL] host:port, no scheme (code prepends http://)
LASER_TENDER_COST_API=
WORKER_API_KEY=

# --- Tender portal logins ---
# [REQUIRED]
TENDER_TIGER_EMAIL=
TENDER_TIGER_PASSWORD=
TENDER247_EMAIL=
TENDER247_PASSWORD=

# --- Google Drive ---
# [OPTIONAL] OAuth files, relative to project root
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_TOKEN_PATH=token.json
GOOGLE_DRIVE_FOLDER_ID=
# [OPTIONAL] service account; use literal \n in the key
GDRIVE_CLIENT_EMAIL=
GDRIVE_PRIVATE_KEY=

# --- S3 storage ---
# [REQUIRED] S3_REGION and S3_PUBLIC_URL have defaults
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# PUBLIC_URL_ENV takes precedence over S3_PUBLIC_URL
S3_PUBLIC_URL=
# PUBLIC_URL_ENV=

# --- File system paths ---
# [OPTIONAL] default D:\temp, set on Linux
TENDER_PARSING_TEMP_DIR=/tmp/tender-parsing
# [OPTIONAL] network shares used by parsing workers
INDEXER_NETWORK_PATH=
COSTING_FILE_NETWORK_PATH=
CONDUTOR_PATH=

# --- Browser ---
# [REQUIRED] /usr/bin/chromium in Docker
CHROME_PATH=
# [OPTIONAL]
HEADLESS_BROWSER=true

# --- Worker dashboard ---
# [OPTIONAL]
DASHBOARD_LOG_DIR=
DASHBOARD_LOG_LIMIT=2000

# --- docker-compose only (shell env, not read by Python) ---
# APP_VERSION=latest
# KESTRA_EXTERNAL_API_KEY=
